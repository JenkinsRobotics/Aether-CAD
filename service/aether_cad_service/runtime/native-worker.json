        "type": "object",
        "properties": {
          "app": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "enum": [
              "cad"
            ]
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "feature_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "angle_deg": {
            "type": "number",
            "minimum": 1e-06,
            "maximum": 360
          },
          "second_angle_deg": {
            "type": "number",
            "minimum": 0,
            "maximum": 360
          },
          "symmetric": {
            "type": "boolean"
          },
          "reversed": {
            "type": "boolean"
          }
        },
        "required": [
          "app",
          "id",
          "feature_id",
          "angle_deg",
          "second_angle_deg",
          "symmetric",
          "reversed"
