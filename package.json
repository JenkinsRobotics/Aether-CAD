{
  "name": "aether-cad",
  "private": true,
  "version": "0.1.0-alpha.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:test-window": "vite --host 127.0.0.1 --port 5174 --strictPort --mode cad-test-window",
    "build": "tsc -b && vite build && npm run build:automation",
    "test": "vitest run",
    "check": "tsc -b --pretty false",
    "smoke:step": "node scripts/smoke-step.mjs",
    "smoke:browser": "node scripts/e2e-import.mjs",
    "build:automation": "node scripts/build-automation.mjs",
    "test:headless": "npm run build:automation && node scripts/verify-headless-kernel.mjs"
  },
  "dependencies": {
    "@aether/assets": "file:vendor/aether-assets-0.2.0-alpha.32.tgz",
    "@aether/core": "file:./aether-engine",
    "@aether/files": "file:vendor/aether-files-0.1.0-alpha.2.tgz",
    "@aether/protocol": "file:vendor/aether-protocol-0.1.0-alpha.12.tgz",
    "@aether/session": "file:vendor/aether-session-0.2.0-alpha.192.home.6.tgz",
    "@aether/sketch": "file:vendor/aether-sketch-0.2.0-alpha.4.tgz",
    "@aether/ui": "file:vendor/aether-ui-0.2.0-alpha.272.tgz",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0",
    "three-mesh-bvh": "0.9.17"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "@aether/assets": "$@aether/assets",
    "@aether/ui": "$@aether/ui"
  }
}
