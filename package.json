    "@aether/sketch": "file:vendor/aether-sketch-0.2.0-alpha.4.tgz",
    "@aether/ui": "file:vendor/aether-ui-0.2.0-alpha.145.tgz",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "jsdom": "^25.0.1",
