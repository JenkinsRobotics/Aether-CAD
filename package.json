  "version": "0.1.0-alpha.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:test-window": "vite --host 127.0.0.1 --port 5174 --strictPort --mode cad-test-window",
    "build": "tsc -b && vite build && npm run build:automation",
